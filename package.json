{
  "name": "biggest-loser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aplikasi rekod cabaran Biggest Loser",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "check": "node --check server.js && node --check public/app.js && node --check public/model.js && node --check public/activity-image.js",
    "build": "tailwindcss -i ./src/styles.css -o ./public/styles.css --minify",
    "css:watch": "tailwindcss -i ./src/styles.css -o ./public/styles.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
